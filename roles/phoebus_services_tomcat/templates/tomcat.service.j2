[Unit]
Description=Tomcat
After=syslog.target network.target

StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=forking

User={{ phoebus_services_tomcat_account }}
Group={{ phoebus_services_tomcat_account }}

Restart=on-failure
RestartSec=5s

Environment=JAVA_HOME="{{ phoebus_services_tomcat_java_home }}"
Environment='JAVA_OPTS=-Djava.awt.headless=true'

Environment=CATALINA_HOME="{{ phoebus_services_tomcat_dest }}"
Environment=CATALINA_BASE="{{ phoebus_services_tomcat_dest }}"
Environment=CATALINA_PID="{{ phoebus_services_tomcat_dest }}/temp/tomcat.pid"

ExecStart="{{ phoebus_services_tomcat_dest }}/bin/startup.sh"
ExecStop="{{ phoebus_services_tomcat_dest }}/bin/shutdown.sh"

[Install]
WantedBy=multi-user.target
