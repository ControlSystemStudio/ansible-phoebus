# File /etc/systemd/system/phoebus_services_cf.service
#
# After changes
#   sudo systemctl daemon-reload
#
# Start/status/stop
#   sudo systemctl start phoebus_services_cf.service
#   sudo systemctl status phoebus_services_cf.service
#   sudo systemctl stop phoebus_services_cf.service
#
# Start when computer boots:
#   sudo systemctl enable phoebus_services_cf.service
#

[Unit]
Description=ChannelFinder service
Documentation=https://github.com/ChannelFinder/ChannelFinderService
Wants=network-online.target
After=phoebus_services_elasticsearch.service
Requires=phoebus_services_elasticsearch.service

StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
User={{ phoebus_services_cf_account }}
Group={{ phoebus_services_cf_account }}

Restart=on-failure
RestartSec=5s

Environment=JAVA_HOME={{ phoebus_services_cf_java_home }}
Environment=PATH={{ phoebus_services_cf_java_home }}/bin:/usr/bin:/usr/local/bin
Environment=SERVER={{ phoebus_services_cf_root }}
Environment=PORT={{ phoebus_services_cf_procserv_port }}

ExecStart=/usr/bin/procServ --foreground --noautorestart --name cf --chdir ${SERVER} --pidfile ${SERVER}/cf.pid --logfile ${SERVER}/console.log ${PORT} ./run-cf.sh

# Specifies the maximum file descriptor number that can be opened by this process
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
