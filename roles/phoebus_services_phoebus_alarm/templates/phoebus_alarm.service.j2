# File /etc/systemd/system/phoebus_services_phoebus_alarm.service
#
# After changes
#   sudo systemctl daemon-reload
#
# Start/status/stop
#   sudo systemctl start phoebus_services_phoebus_alarm.service
#   sudo systemctl status phoebus_services_phoebus_alarm.service
#   sudo systemctl stop phoebus_services_phoebus_alarm.service
#
# Start when computer boots:
#   sudo systemctl enable phoebus_services_phoebus_alarm.service
#

[Unit]
Description=alarm service
Documentation=https://github.com/shroffk/phoebus/tree/master/services/alarm-server
Wants=network-online.target
After=phoebus_services_kafka.service
Requires=phoebus_services_kafka.service

StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
User={{ phoebus_services_phoebus_alarm_account }}
Group={{ phoebus_services_phoebus_alarm_account }}

Restart=on-failure
RestartSec=5s

Environment=JAVA_HOME={{ phoebus_services_phoebus_alarm_java_home }}
Environment=PATH={{ phoebus_services_phoebus_alarm_java_home }}/bin:/usr/bin:/usr/local/bin
Environment=SERVER={{ phoebus_services_phoebus_alarm_root }}/alarm_server
Environment=PORT={{ phoebus_services_phoebus_alarm_server_procserv_port }}

Environment=SETTINGS={{ phoebus_services_phoebus_alarm_root }}/phoebus_alarm_preferences.ini

ExecStart=/usr/bin/procServ --foreground --noautorestart --name alarm-server --chdir ${SERVER} --logfile ${SERVER}/console.log --pidfile ${SERVER}/phoebus-alarm.pid ${PORT} ./run-phoebus-alarm.sh -settings ${SETTINGS}

# Specifies the maximum file descriptor number that can be opened by this process
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
