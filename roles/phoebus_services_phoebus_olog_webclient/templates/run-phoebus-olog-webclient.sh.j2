#!/bin/bash
set -e

cd "{{ phoebus_services_phoebus_olog_webclient_project_path }}"
export PORT={{ phoebus_services_phoebus_olog_webclient_http_port }}

if [ ! -f .env.production.local ]; then
    echo "Missing .env.production.local; deploy the Olog webclient configuration before starting." >&2
    exit 1
fi

npm install
npm run build
npm install --global --prefix "$HOME/.local" serve
exec "$HOME/.local/bin/serve" -s build -l "$PORT"
