# File /etc/systemd/system/phoebus_services_phoebus_olog_webclient.service
#
# After changes
#   sudo systemctl daemon-reload
#
# Start/status/stop
#   sudo systemctl start phoebus_services_phoebus_olog_webclient.service
#   sudo systemctl status phoebus_services_phoebus_olog_webclient.service
#   sudo systemctl stop phoebus_services_phoebus_olog_webclient.service
#
# Start when computer boots:
#   sudo systemctl enable phoebus_services_phoebus_olog_webclient.service
#

[Unit]
Description=phoebus olog webclient service
Documentation=https://olog.readthedocs.io/en/latest/
Wants=network-online.target
After=phoebus_services_phoebus_olog.service
Requires=phoebus_services_phoebus_olog.service

StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
User={{ phoebus_services_phoebus_olog_webclient_account }}
Group={{ phoebus_services_phoebus_olog_webclient_account }}

Restart=on-failure
RestartSec=5s

Environment=SERVER={{ phoebus_services_phoebus_olog_webclient_project_path }}
Environment=PROC_PORT={{ phoebus_services_phoebus_olog_webclient_procserv_port }}

ExecStart=/usr/bin/procServ --foreground --noautorestart --name phoebus_olog_webclient --chdir ${SERVER} --pidfile ${SERVER}/olog_webclient.pid --logfile ${SERVER}/console.log ${PROC_PORT} ./run-phoebus-olog-webclient.sh

# Specifies the maximum file descriptor number that can be opened by this process
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
