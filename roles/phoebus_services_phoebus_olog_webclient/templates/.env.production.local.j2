# Production overrides for the placeholders in upstream .env.production.
# Base URL of the Backend OLOG service. API calls will be made
# relative to this service URL.
VITE_APP_BASE_URL="{{ phoebus_services_phoebus_olog_webclient_olog_url }}"
VITE_APP_BACKEND_URL="{{ phoebus_services_phoebus_olog_webclient_olog_url }}"

# WebSocket endpoint for live updates.
VITE_APP_WEBSOCKET_BASE_URL="{{ phoebus_services_phoebus_olog_webclient_websocket_url | default('wss://localhost:4181/Olog/web-socket') }}"

# Public path for built static assets. Use "/" for root deployment or
# a subpath such as "/olog/" if the app is mounted under a prefix.
VITE_APP_PUBLIC_PATH="{{ phoebus_services_phoebus_olog_webclient_public_path | default('/') }}"

# Support, Swagger, and app metadata.
VITE_APP_SUPPORT_HREF="{{ phoebus_services_phoebus_olog_webclient_support_href | default('https://github.com/Olog/phoebus-olog-web-client') }}"
VITE_APP_SWAGGER_URL="{{ phoebus_services_phoebus_olog_webclient_swagger_url | default('https://localhost:4181/Olog/api/swagger-ui') }}"
VITE_APP_APP_TITLE="{{ phoebus_services_phoebus_olog_webclient_app_title | default('Olog') }}"
