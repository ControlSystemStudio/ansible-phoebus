[Unit]
Description=MongoDB Database Server {{ phoebus_services_mongodb_service_name }}
Documentation=https://docs.mongodb.com/manual
After=network-online.target
Wants=network-online.target

[Service]
User={{ phoebus_services_mongodb_account }}
Group={{ phoebus_services_mongodb_account }}
Environment="OPTIONS=-f {{ phoebus_services_mongodb_config_path }}"
EnvironmentFile=-/etc/sysconfig/mongod
ExecStart=/usr/bin/mongod $OPTIONS

ExecStartPre=/usr/bin/mkdir -p {{ phoebus_services_mongodb_run_path }}
ExecStartPre=/usr/bin/chown {{ phoebus_services_mongodb_account }}:{{ phoebus_services_mongodb_account }} {{ phoebus_services_mongodb_run_path }}
ExecStartPre=/usr/bin/chmod 0755 {{ phoebus_services_mongodb_run_path }}

PermissionsStartOnly=true
PIDFile={{ phoebus_services_mongodb_pid_file }}
Type=forking
# file size
LimitFSIZE=infinity
# cpu time
LimitCPU=infinity
# virtual memory size
LimitAS=infinity
# open files
LimitNOFILE=64000
# processes/threads
LimitNPROC=64000
# locked memory
LimitMEMLOCK=infinity
# total threads (user+kernel)
TasksMax=infinity
TasksAccounting=false
# Recommended limits for mongod as specified in
# https://docs.mongodb.com/manual/reference/ulimit/#recommended-ulimit-settings

[Install]
WantedBy=multi-user.target
